const STALE_WINDOW_MS = 2 * 60 * 1000;
const DEFAULT_BUS_SPEED_KMPH = 30; // Default speed for ETA calculation when actual speed is 0
const HALTED_SPEED_THRESHOLD = 2; // km/h - below this is considered halted
const EARTH_RADIUS_KM = 6371;

// Store previous bus locations for speed calculation
const busHistoryCache = new Map();
const CACHE_MAX_AGE_MS = 5 * 60 * 1000; // 5 minutes

// Clean old cache entries
const cleanBusHistoryCache = () => {
  const now = Date.now();
  let cleaned = 0;
  for (const [busId, data] of busHistoryCache.entries()) {
    if (now - data.time > CACHE_MAX_AGE_MS) {
      busHistoryCache.delete(busId);
      cleaned++;
    }
  }
  if (cleaned > 0) {
    console.log("[CLEAN] PASSENGER: Cleaned " + cleaned + " old cache entries | CACHE: " + busHistoryCache.size);
  }
};

// Get cache size for logging
