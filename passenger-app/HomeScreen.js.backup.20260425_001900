// Haversine distance calculation between two coordinates
function haversineDistanceKm(lat1, lng1, lat2, lng2) {
  const toRad = (deg) => (deg * Math.PI) / 180;
  const dLat = toRad(lat2 - lat1);
  const dLng = toRad(lng2 - lng1);
  const a =
    Math.sin(dLat / 2) * Math.sin(dLat / 2) +
    Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLng / 2) * Math.sin(dLng / 2);
  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  return EARTH_RADIUS_KM * c;
}

// Calculate speed from previous and current position
function calculateSpeedKmH(busId, currentLat, currentLng, timestamp) {
  // Clean old entries periodically
  if (Math.random() < 0.1) cleanBusHistoryCache(); // 10% chance each call
  
  const now = timestamp ? new Date(timestamp).getTime() : Date.now();
  const prevData = busHistoryCache.get(busId);

  if (!prevData) {
    busHistoryCache.set(busId, { lat: currentLat, lng: currentLng, time: now });
    return 0;
  }

  const timeDiffHours = (now - prevData.time) / (1000 * 60 * 60); // Convert ms to hours
  if (timeDiffHours <= 0) return prevData.speed || 0;

  const distanceKm = haversineDistanceKm(prevData.lat, prevData.lng, currentLat, currentLng);
  const speed = distanceKm / timeDiffHours;

  // Update cache with current data
  busHistoryCache.set(busId, {
    lat: currentLat,
    lng: currentLng,
    time: now,
    speed: speed,
  });

  return speed;
}

// Calculate ETA in minutes
function calculateEtaMinutes(distanceKm, speedKmH) {
  const effectiveSpeed = speedKmH > 0 ? speedKmH : DEFAULT_BUS_SPEED_KMPH;
  const etaHours = distanceKm / effectiveSpeed;
  return Math.ceil(etaHours * 60);
}

function toNumber(value) {
  const num = Number(value);
  // Reject null, undefined, NaN only (0 is a valid coordinate)
  if (!Number.isFinite(num)) return null;
  return num;
}

// Extract and validate coordinates from bus object
function getValidCoords(bus) {
  if (!bus) return null;
  
  // [TRACE 2] Log raw extraction attempt
  console.log("[TRACE 2] Extracting coords:", {
    busId: bus.busId,
    lat: bus.lat,
    lng: bus.lng,
    latitude: bus.latitude,
    longitude: bus.longitude,
    coords: bus.location?.coordinates
  });
  
  let lat = null;
  let lng = null;

  if (Number.isFinite(Number(bus.lat)) && Number.isFinite(Number(bus.lng))) {
    lat = Number(bus.lat);
    lng = Number(bus.lng);
  }
  else if (Number.isFinite(Number(bus.latitude)) && Number.isFinite(Number(bus.longitude))) {
    lat = Number(bus.latitude);
    lng = Number(bus.longitude);
  }
  else if (bus.location?.coordinates?.length === 2) {
    lng = Number(bus.location.coordinates[0]); // GeoJSON [lng, lat]
    lat = Number(bus.location.coordinates[1]);
  }

  if (!Number.isFinite(lat) || !Number.isFinite(lng)) return null;
  if (Math.abs(lat) > 90 || Math.abs(lng) > 180) return null;
  if (lat === 0 && lng === 0) return null;

  return { lat, lng };
}

function getEta(bus) {
  // Use calculated ETA if available
  if (Number.isFinite(bus?.calculatedEtaMinutes)) {
    return bus.calculatedEtaMinutes + " min";
  }
  // Fallback to backend-provided ETA
  if (bus?.eta !== undefined && bus?.eta !== null) return String(bus.eta);
  if (bus?.etaMinutes !== undefined && bus?.etaMinutes !== null) return bus.etaMinutes + " min";
  if (bus?.eta_min !== undefined && bus?.eta_min !== null) return bus.eta_min + " min";
  return "ETA unavailable";
}

function getSpeed(bus) {
  // Use calculated speed if available
  const speed = Number(bus?.calculatedSpeed) ?? Number(bus?.speed);
  if (!Number.isFinite(speed) || speed < 0) return "0 km/h";
  return speed.toFixed(1) + " km/h";
}

function getDistance(bus) {
  // Use calculated distance if available
  const distance = Number(bus?.calculatedDistance) ?? Number(bus?.distanceKm);
  if (!Number.isFinite(distance) || distance < 0) return "N/A";
  return distance.toFixed(2) + " km";
}

function getStatus(bus) {
  // Calculate status based on speed
  const speed = Number(bus?.calculatedSpeed) ?? Number(bus?.speed) ?? 0;
  if (speed < HALTED_SPEED_THRESHOLD) return "[HALT] Halted";
  return "[MOVE] Moving";
}

function getNextStopName(bus) {
  // Use routeInfo if available
  if (bus?.routeInfo?.nextStop) {
    return bus.routeInfo.nextStop;
  }
  return bus?.nextStop || "N/A";
}

function getRouteBasedETA(bus) {
  // Use route-based ETA if available
  if (bus?.routeInfo?.etaMinutes) {
    return bus.routeInfo.etaMinutes + " min (via route)";
  }
  return getEta(bus);
}

function getStopsAway(bus) {
  if (bus?.routeInfo?.stopsAway !== undefined) {
    const stops = bus.routeInfo.stopsAway;
    return stops === 0 ? "Arriving now" : stops + " stop" + (stops > 1 ? "s" : "") + " away";
  }
  return "";
}

function getRouteName(bus) {
  return bus?.routeInfo?.routeName || bus?.routeId || "Unknown Route";
}

function getLastUpdatedLabel(bus) {
  const value = bus?.updatedAt || bus?.timestamp;
  if (!value) return "Last updated: unknown";

  const updatedAtMs = new Date(value).getTime();
  if (!Number.isFinite(updatedAtMs)) return "Last updated: unknown";

  const ageSec = Math.max(0, Math.floor((Date.now() - updatedAtMs) / 1000));
  return "Last updated: " + ageSec + "s ago";
}

function escapeText(input) {
  return String(input ?? "Bus").replace(/\\/g, "\\\\").replace(/"/g, '\\"');
}

function smoothMove(prev, next) {
  if (
    !prev ||
    !Number.isFinite(prev.latitude) ||
    !Number.isFinite(prev.longitude) ||
    !next ||
    !Number.isFinite(next.latitude) ||
    !Number.isFinite(next.longitude)
  ) {
    return next;
  }
  return {
    latitude: prev.latitude + (next.latitude - prev.latitude) * 0.2,
    longitude: prev.longitude + (next.longitude - prev.longitude) * 0.2,
  };
}

function getBusColor(speed) {
  const value = Number(speed) || 0;
  if (value <= 0) return "#808080";
  if (value < 20) return "#ff9800";
  return "#22c55e";
}

function getSmartStatus(bus) {
  // Use calculated values or fallbacks
  const distanceKm = Number(bus?.calculatedDistance ?? bus?.distanceKm);
  const speed = Number(bus?.calculatedSpeed ?? bus?.speed) || 0;

  if (Number.isFinite(distanceKm) && distanceKm < 0.05) return "[OK] Arrived";
  if (Number.isFinite(distanceKm) && distanceKm < 0.2) return "[WARN] Approaching";
  if (speed < HALTED_SPEED_THRESHOLD) return "[HALT] Halted";
  return "[MOVE] Moving";
}

function getDriverSignalStatus(bus) {
  const value = bus?.updatedAt || bus?.timestamp;
  const stamp = new Date(value).getTime();
  if (!Number.isFinite(stamp)) return "[STOP] No Signal";
  const ageSec = Math.max(0, Math.floor((Date.now() - stamp) / 1000));
  return ageSec < 10 ? "[OK] Active" : "[STOP] No Signal";
}

