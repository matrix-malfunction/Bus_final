            [BUS] Next Stop: {etaInfo.nextStop}
          </Text>
          <Text style={{ fontSize: 14, marginTop: 5 }}>[ETA] ETA: {etaInfo.eta} mins</Text>
        </View>
      )}

      <View style={styles.mapCard}>
        <TouchableOpacity
          activeOpacity={1}
          onPress={() => {
            navigation.navigate("FullMap", {
              buses: validBuses,
              userLocation,
              center,
            });
          }}
        >
          <View style={styles.mapContainer} pointerEvents="box-none">
            <WebView
              ref={webViewRef}
              key={userLocation ? "map-ready" : "map-init"}
              originWhitelist={['*']}
              source={{ html: mapHTML }}
              style={{ flex: 1 }}
              javaScriptEnabled={true}
              domStorageEnabled={true}
              allowFileAccess={true}
              mixedContentMode="always"
              injectedJavaScript={`window.__CYCLE_ID__ = ${cycleIdRef.current}; true;`}
              onLoadEnd={() => {
                const currentCycleId = cycleIdRef.current;
                console.log(`[VERIFY] New cycleId: ${currentCycleId}`);

                // Reset all validation refs for new cycle
                mapEventOrderRef.current = [];
                lastEventRef.current = null;
                cycleLockRef.current = false;

                // [SYNC] Ensure cycleId is correct (handles WebView reuse/partial reload)
                // Trigger forceMapRender from React Native onLoadEnd injection
                webViewRef.current?.injectJavaScript(`
                  if (window.__CYCLE_ID__ !== ${currentCycleId}) {
                    window.__CYCLE_ID__ = ${currentCycleId};
                    console.log("[SYNC] cycleId corrected to: " + ${currentCycleId});
                  }
                  if (window.forceMapRender) {
                    window.forceMapRender();
                    console.log("[FIX] RE-TRIGGERED FROM RN onLoadEnd");
                  }
                  // Fallback: dispatch resize event to force Leaflet recalculation
                  setTimeout(function() {
                    window.dispatchEvent(new Event('resize'));
                    console.log("[FALLBACK] Resize event dispatched");
                  }, 100);
                  true;
                `);

                // Prepare next cycleId for navigation/reload (no re-render)
                cycleIdRef.current += 1;
              }}
              onMessage={(event) => {
                try {
                  const msg = JSON.parse(event.nativeEvent.data);
                  
                  // [STEP 2] Handle LOG messages from WebView
                  if (msg.type === 'LOG') {
                    console.log("[WEBVIEW]", ...msg.data);
                    return;
                  }

                  // [VERIFY] Map rendering events from WebView with strict order validation
                  const validOrder = ['MAP_READY', 'MAP_RENDER_TRIGGERED', 'MAP_SIZE_FIXED'];
                  
                  if (msg.type === 'MAP_READY' || msg.type === 'MAP_RENDER_TRIGGERED' || msg.type === 'MAP_SIZE_FIXED') {
                    // [0] Race-condition protection - ignore stale events from previous cycles
                    const eventCycleId = msg.cycleId || 0;
                    const currentCycleId = cycleIdRef.current;
                    if (eventCycleId !== currentCycleId) {
                      console.log(`[IGNORE] ${msg.type} from stale cycle ${eventCycleId} (current: ${currentCycleId})`);
                      return;
                    }
                    
                    // [1] Duplicate protection - ignore same event consecutively
                    if (lastEventRef.current === msg.type) {
                      console.log(`[SKIP] Duplicate ${msg.type} ignored`);
                      return;
                    }
                    lastEventRef.current = msg.type;
                    
                    // [2] Cycle lock - stop processing after final pass
                    if (cycleLockRef.current) {
                      console.log(`[LOCKED] ${msg.type} ignored - cycle already complete`);
                      return;
                    }
                    
                    console.log(`[RN RECEIVED] ${msg.type} (cycleId: ${currentCycleId})`);
                    mapEventOrderRef.current.push(msg.type);
                    
                    // Validate after each event
                    const current = mapEventOrderRef.current;
                    const expected = validOrder.slice(0, current.length);
                    
                    if (JSON.stringify(current) !== JSON.stringify(expected)) {
                      console.log(`[FAIL] Wrong order: got [${current.join(' → ')}], expected [${expected.join(' → ')}]`);
                      mapEventOrderRef.current = []; // Reset for next cycle
                      return;
                    }
                    
                    // Check if complete valid sequence
                    if (current.length === 3) {
                      cycleLockRef.current = true; // Lock cycle
                      console.log("✅ [FINAL PASS] Correct event order: MAP_READY → MAP_RENDER_TRIGGERED → MAP_SIZE_FIXED");
                      
                      // [3] Auto-reset after 2 seconds for next navigation
                      setTimeout(() => {
                        mapEventOrderRef.current = [];
                        lastEventRef.current = null;
                        cycleLockRef.current = false;
                        console.log("[VERIFY] Auto-reset complete - ready for next cycle");
                      }, 2000);
                    }
                    return;
                  }

                  if (msg.type === 'WEBVIEW_READY') {
                    console.log("[OK] WebView reported ready at", msg.timestamp);
                    setWebViewReady(true);
                  } else if (msg.type === 'NAVIGATE_BUS_DETAILS') {
                    if (navigatingRef.current) return;

                    navigatingRef.current = true;

                    navigation.navigate('BusDetails', {
                      busId: msg.busId,
                      stops: msg.stops || []
                    });

                    setTimeout(() => {
                      navigatingRef.current = false;
                    }, 1000);
                  } else if (msg.type === 'BREAKDOWN_ALERT') {
                    if (!breakdownAlerts.has(msg.busId) && inBusStatus[msg.busId]) {
                      Alert.alert("🚨 BUS BREAKDOWN", msg.message || "Bus has broken down");

                      setBreakdownAlerts(prev => {
                        const updated = new Set(prev);
                        updated.add(msg.busId);
                        return updated;
                      });
                    }
                  }
                } catch (err) {
                  console.log("[WEBVIEW RAW]", event.nativeEvent.data);
                }
              }}
            />
          </View>
          <View style={styles.previewFooter}>
            <Text style={styles.previewText}>Tap to expand full map</Text>
          </View>
        </TouchableOpacity>
      </View>

      <Button title="Fetch Nearby Buses" onPress={fetchBuses} />

      <Text style={styles.status}>{status}</Text>

      {validBuses.length === 0 ? (
        <View style={styles.emptyCard}>
          <Text style={styles.emptyText}>No buses available yet. Tap fetch to load nearby buses.</Text>
        </View>
      ) : (
        validBuses.map((bus) => (
          <View key={bus.key} style={styles.busCard}>
            <Text style={styles.busName}>{bus.name}</Text>
            <Text style={styles.busMeta}>
              Coordinates: {bus.latitude}, {bus.longitude}
            </Text>
            <Text style={styles.busEta}>ETA: {getEta(bus)}</Text>
            <Text style={styles.busMeta}>Speed: {getSpeed(bus)}</Text>
            <Text style={styles.busMeta}>Distance: {getDistance(bus)}</Text>
            <Text style={styles.busMeta}>Status: {getSmartStatus(bus)}</Text>
            <Text style={styles.busMeta}>Driver: {getDriverSignalStatus(bus)}</Text>
            <Text style={styles.busMeta}>Next stop: {getNextStopName(bus)}</Text>
            <Text style={styles.busMeta}>{getLastUpdatedLabel(bus)}</Text>
          </View>
        ))
      )}
    </ScrollView>
  );
}

