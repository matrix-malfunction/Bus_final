            medium: { text: 'Fairly reliable', icon: '~', color: COLORS.WARNING },
            low: { text: 'Less reliable', icon: '?', color: COLORS.NEUTRAL }
          };
          
          // Calculate ETA confidence based on speed stability
          function getETAConfidence(busId, speedHistory) {
            if (!speedHistory || speedHistory.length < 3) return 'low';
            
            // Calculate speed variance
            const mean = speedHistory.reduce((a, b) => a + b, 0) / speedHistory.length;
            const variance = speedHistory.reduce((sum, speed) => sum + Math.pow(speed - mean, 2), 0) / speedHistory.length;
            const stdDev = Math.sqrt(variance);
            
            // Low variance = high confidence
            if (stdDev < 5) return 'high';      // Very stable speed
