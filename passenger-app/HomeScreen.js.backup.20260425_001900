  };

  // ============================================================
  // MOTION PREDICTION
  // ============================================================
  
  // Store previous positions for velocity calculation
  const motionStateRef = useRef(new Map()); // busId -> { lat, lng, time, velocityMps }
  
  // Constants for improved prediction
  const STOP_THRESHOLD_METERS = 10;       // Stop detection threshold
  const MAX_VELOCITY_MPS = 30;            // ~108 km/h max bus speed
  const VELOCITY_SMOOTHING = 0.3;         // 30% new, 70% previous
  const PREDICTION_TIME_MS = 1500;        // 1.5s prediction horizon
  const MAX_PREDICTION_ERROR_KM = 0.5;    // 500m safety limit
  const BLEND_ACTUAL = 0.7;               // 70% actual
  const BLEND_PREDICTED = 0.3;            // 30% predicted
  const TURN_THRESHOLD_DEGREES = 45;      // Turn detection threshold
  const TURN_COOLDOWN_MS = 2000;          // 2 second cooldown after turn
  const MIN_SPEED_FOR_TURN_MPS = 2;       // Skip turn detection below 2 m/s (~7 km/h)
  
  // Convert lat/lng displacement to meters (approximate at equator)
  const latToMeters = (dLat) => dLat * 111000;  // 1 deg lat ≈ 111 km
  const lngToMeters = (dLng, lat) => dLng * 111000 * Math.cos(lat * Math.PI / 180);
  const metersToLat = (meters) => meters / 111000;
  const metersToLng = (meters, lat) => meters / (111000 * Math.cos(lat * Math.PI / 180));
  
  // Haversine distance for safety checks
  const haversineKm = (lat1, lng1, lat2, lng2) => {
    const R = 6371;
    const toRad = deg => (deg * Math.PI) / 180;
    const dLat = toRad(lat2 - lat1);
    const dLng = toRad(lng2 - lng1);
    const a = Math.sin(dLat / 2) ** 2 + 
              Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * 
              Math.sin(dLng / 2) ** 2;
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  };
  
  // Predict next position using meter-based velocity
  const predictPosition = (busId, currentLat, currentLng, currentTime) => {
    const prevState = motionStateRef.current.get(busId);
    
    // First update - no prediction possible
    if (!prevState) {
      motionStateRef.current.set(busId, { 
        lat: currentLat, 
        lng: currentLng, 
        time: currentTime,
        velocityMps: { x: 0, y: 0 },
        lastTurnTime: 0,
        sampleCount: 1  // Start sample count
      });
      return { lat: currentLat, lng: currentLng, predicted: false };
    }
    
    const dtSeconds = (currentTime - prevState.time) / 1000;
    
    // Need meaningful time delta
    if (dtSeconds < 0.5) {
      return { lat: currentLat, lng: currentLng, predicted: false };
    }
    
    // 0. TURN COOLDOWN CHECK: If recently turned, stay on actual position
    const timeSinceLastTurn = currentTime - (prevState.lastTurnTime || 0);
    if (timeSinceLastTurn < TURN_COOLDOWN_MS) {
      // During cooldown, update position but don't predict
      motionStateRef.current.set(busId, {
        ...prevState,
        lat: currentLat,
        lng: currentLng,
        time: currentTime,
        sampleCount: (prevState.sampleCount || 0) + 1  // Continue counting
      });
      return { lat: currentLat, lng: currentLng, predicted: false, inCooldown: true };
    }
    
    // 0b. PREDICTION WARM-UP: Need minimum samples before predicting
    const currentSampleCount = (prevState.sampleCount || 0) + 1;
    if (currentSampleCount < 3) {
      // Not enough samples yet, store and return actual
      motionStateRef.current.set(busId, {
        ...prevState,
        lat: currentLat,
        lng: currentLng,
        time: currentTime,
        sampleCount: currentSampleCount
      });
      return { lat: currentLat, lng: currentLng, predicted: false, warmingUp: true };
    }
    
    // 2. STOP DETECTION: Calculate movement in meters
    const dLatMeters = latToMeters(currentLat - prevState.lat);
    const dLngMeters = lngToMeters(currentLng - prevState.lng, currentLat);
    const movementMeters = Math.sqrt(dLatMeters * dLatMeters + dLngMeters * dLngMeters);
    
    // If bus stopped or moving very slowly, disable prediction
    if (movementMeters < STOP_THRESHOLD_METERS) {
      motionStateRef.current.set(busId, {
        lat: currentLat,
        lng: currentLng,
        time: currentTime,
        velocityMps: { x: 0, y: 0 },  // Reset velocity
        sampleCount: currentSampleCount  // Keep sample count
      });
      return { lat: currentLat, lng: currentLng, predicted: false };
    }
    
    // 1. METER-BASED VELOCITY: Compute in m/s
    const velocityXMps = dLngMeters / dtSeconds;  // East velocity
    const velocityYMps = dLatMeters / dtSeconds;  // North velocity
    
    // 3. VELOCITY STABILITY: Clamp and smooth
    const rawSpeed = Math.sqrt(velocityXMps * velocityXMps + velocityYMps * velocityYMps);
    
    // Clamp velocity spikes (bus can't go faster than ~108 km/h)
    let clampedVelocityX = velocityXMps;
    let clampedVelocityY = velocityYMps;
    if (rawSpeed > MAX_VELOCITY_MPS) {
      const scale = MAX_VELOCITY_MPS / rawSpeed;
      clampedVelocityX *= scale;
      clampedVelocityY *= scale;
    }
    
    // 4. TURN DETECTION: Check angle between previous and current velocity
    const prevVel = prevState.velocityMps || { x: 0, y: 0 };
    const prevSpeed = Math.sqrt(prevVel.x * prevVel.x + prevVel.y * prevVel.y);
    
    // Skip turn detection at low speeds (unreliable heading)
    const isLowSpeed = prevSpeed < MIN_SPEED_FOR_TURN_MPS || rawSpeed < MIN_SPEED_FOR_TURN_MPS;
    
    if (!isLowSpeed && prevSpeed > 1) {  // Only check if we have meaningful velocity and not low speed
      // Calculate angle between vectors using dot product
      const dotProduct = prevVel.x * clampedVelocityX + prevVel.y * clampedVelocityY;
      const cosAngle = dotProduct / (prevSpeed * rawSpeed);
      const angleDegrees = Math.acos(Math.max(-1, Math.min(1, cosAngle))) * (180 / Math.PI);
      
      // If turn is sharp (> 45 degrees), disable prediction and reset velocity
      if (angleDegrees > TURN_THRESHOLD_DEGREES) {
        if (__DEV__) console.log("[TURN] Turn detected for " + busId + ": " + angleDegrees.toFixed(1));
        motionStateRef.current.set(busId, {
          lat: currentLat,
          lng: currentLng,
          time: currentTime,
          velocityMps: { x: 0, y: 0 },  // Reset velocity smoothing
          lastTurnTime: currentTime,    // Start cooldown period
          sampleCount: 0              // Reset sample count (warm-up phase)
        });
        return { lat: currentLat, lng: currentLng, predicted: false, turned: true };
      }
    }
    
    // Smooth velocity: 70% previous + 30% current
    const smoothedVelocityX = prevVel.x * (1 - VELOCITY_SMOOTHING) + clampedVelocityX * VELOCITY_SMOOTHING;
    const smoothedVelocityY = prevVel.y * (1 - VELOCITY_SMOOTHING) + clampedVelocityY * VELOCITY_SMOOTHING;
    
    // 1. PREDICT IN METERS: Move position by velocity * time
    const predictionSeconds = PREDICTION_TIME_MS / 1000;
    const predictedXMeters = smoothedVelocityX * predictionSeconds;
    const predictedYMeters = smoothedVelocityY * predictionSeconds;
    
    // Convert back to lat/lng
    const predictedLat = currentLat + metersToLat(predictedYMeters);
    const predictedLng = currentLng + metersToLng(predictedXMeters, currentLat);
    
    // Update motion state with smoothed velocity (preserve lastTurnTime and sampleCount)
    motionStateRef.current.set(busId, { 
      lat: currentLat, 
      lng: currentLng, 
      time: currentTime,
      velocityMps: { x: smoothedVelocityX, y: smoothedVelocityY },
      lastTurnTime: prevState.lastTurnTime || 0,
      sampleCount: currentSampleCount  // Keep incrementing
    });
    
    // 4. SAFETY CHECK: Prediction shouldn't be too far
    const predictionError = haversineKm(currentLat, currentLng, predictedLat, predictedLng);
    if (predictionError > MAX_PREDICTION_ERROR_KM) {
      if (__DEV__) console.log("[WARN] Prediction too large for " + busId + ": " + predictionError.toFixed(2) + "km");
      return { lat: currentLat, lng: currentLng, predicted: false };
    }
    
    // Blend actual (70%) and predicted (30%)
    const blendedLat = currentLat * BLEND_ACTUAL + predictedLat * BLEND_PREDICTED;
    const blendedLng = currentLng * BLEND_ACTUAL + predictedLng * BLEND_PREDICTED;
    
    return { 
      lat: blendedLat, 
      lng: blendedLng, 
