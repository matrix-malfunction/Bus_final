          // Get next stop using route index instead of nearest
          function getNextStop(bus, stops) {
            if (!stops || stops.length === 0) return null;
            
            // Use route index if available from bus data
            const currentStopIndex = bus.currentStopIndex || bus.lastStopIndex || 0;
            const nextIndex = currentStopIndex + 1;
            
            if (nextIndex < stops.length) {
              return { stop: stops[nextIndex], index: nextIndex };
            }
            
            // Fallback: find nearest stop ahead in route
            return findNextStopInRoute(bus, stops);
          }

          // Find next stop based on distance along route
          function findNextStopInRoute(bus, stops) {
            let minDist = Infinity;
            let nextStop = null;
            let nextIndex = -1;
            
            for (let i = 0; i < stops.length; i++) {
              const dist = haversineKm(
                bus.latitude, bus.longitude,
                stops[i].latitude, stops[i].longitude
              );
              if (dist < minDist && dist > 0.1) { // At least 100m away
                minDist = dist;
                nextStop = stops[i];
                nextIndex = i;
              }
            }
            
            return nextStop ? { stop: nextStop, index: nextIndex } : null;
          }

          // Check if bus is moving toward a stop
          function isMovingTowardStop(bus, stop, prevPos) {
            if (!prevPos || !stop) return true;
            
            const distToStopNow = haversineKm(bus.latitude, bus.longitude, stop.latitude, stop.longitude);
            const distToStopBefore = haversineKm(prevPos.lat, prevPos.lng, stop.latitude, stop.longitude);
            
            // Bus is moving toward stop if distance is decreasing
            // Allow small tolerance for GPS noise (10 meters)
            return distToStopNow < (distToStopBefore + 0.01);
          }

          // ETA smoothing with fixed window median
          window.etaHistory = window.etaHistory || new Map();
          window.lastETA = window.lastETA || new Map();
          window.lastETATimestamp = window.lastETATimestamp || new Map();
          const ETA_WINDOW_SIZE = 5; // Fixed window for median
          
          // Dynamic ETA floor based on distance
          function getDynamicETAFloor(distToStop) {
            if (distToStop < 0.1) return 1;      // < 100m: 1 min floor
            if (distToStop < 0.5) return 2;      // < 500m: 2 min floor
            if (distToStop < 1.0) return 3;      // < 1km: 3 min floor
            return 2;                            // Default: 2 min floor
          }
          
          // Fixed window median for stable ETA
          function getWindowMedian(values) {
            if (values.length === 0) return 0;
            const sorted = [...values].sort((a, b) => a - b);
            const mid = Math.floor(sorted.length / 2);
            return sorted.length % 2 === 0 
              ? Math.round((sorted[mid - 1] + sorted[mid]) / 2)
              : sorted[mid];
          }
          
          function calculateStableETA(busId, distToStop, speed) {
            const now = getServerSyncedTime();
            const state = window.busStates.get(busId) || BUS_STATES.MOVING;
            
            // Freeze ETA when stopped
            if (state === BUS_STATES.STOPPED) {
              const frozenETA = window.lastETA.get(busId);
              if (frozenETA != null) {
                const frozenTime = window.lastETATimestamp.get(busId) || 0;
                if (now - frozenTime < 30000) {
                  return frozenETA;
                }
              }
            }
            
            // State-based minimum speed
            const minSpeedByState = {
              [BUS_STATES.STOPPED]: 5,
              [BUS_STATES.SLOW]: 8,
              [BUS_STATES.MOVING]: 5
            };
            const effectiveSpeed = Math.max(speed, minSpeedByState[state] || 5);
            
            const etaMinutes = Math.ceil((distToStop / effectiveSpeed) * 60);
            
            // Fixed window median (maintains exactly N samples)
            let history = window.etaHistory.get(busId) || [];
            history.push(etaMinutes);
            
            // Maintain fixed window size
            while (history.length > ETA_WINDOW_SIZE) {
              history.shift(); // Remove oldest
            }
            
            window.etaHistory.set(busId, history);
            
            // Use fixed window median
            const median = getWindowMedian(history);
            
            // Apply dynamic floor
            const minFloor = getDynamicETAFloor(distToStop);
            const finalETA = Math.max(median, minFloor);
            
            window.lastETA.set(busId, finalETA);
            window.lastETATimestamp.set(busId, now);
            
            return finalETA;
          }

          // Human-readable ETA confidence labels
          const CONFIDENCE_LABELS = {
